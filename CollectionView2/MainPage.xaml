<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CollectionView2.MainPage">
    

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Slider x:Name="imieEntry"></Slider>
            <Label Text="{Binding Source={x:Reference imieEntry}, Path=Value, StringFormat='Stra: {0:F2}'}"></Label>

            <Label x:Name="imie"></Label>
            <Label x:Name="nazwisko"></Label>
            <Label x:Name="pesel"></Label>
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
